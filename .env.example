# ============================================================
# Recherche- und Scraping-Agent, Konfiguration
# Kopiere diese Datei nach .env und fülle die Werte aus:
#   cp .env.example .env
# Die .env darf NIE committed werden (steht in .gitignore).
# Pflicht ist nur der erste Block. Alles andere ist optional:
# was leer bleibt, wird abgeschaltet, nicht kaputt.
# ============================================================

# --- LLM (Pflicht) ---
# Key holen: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modell für den Agent. Recherche profitiert von einem starken Modell,
# weil der Gegencheck und das Aussortieren daran hängen.
AGENT_MODEL=gpt-4o

# Mock-Modus: true = keine echten API-Calls, Fake-Antworten (kostenlos testen).
# Damit lässt sich die Verdrahtung prüfen, ohne einen Key zu haben.
MOCK_LLM=false

# Wie viele Tool-Runden der Agent maximal drehen darf. Recherche braucht mehr
# als einfache Aufgaben: Suchfächer, 6 und mehr gelesene Seiten, Gegencheck.
MAX_ROUNDS=20

# --- Auftritt (optional, steckt nur im System-Prompt) ---
# Für wen arbeitet der Agent. Leer = neutral formuliert.
OWNER_NAME=
AGENT_NAME=Recherche-Agent
ANSWER_LANGUAGE=Deutsch
# kompakt / ausführlich / stichpunktartig
ANSWER_STYLE=kompakt
TIMEZONE=Europe/Berlin

# --- Websuche (optional) ---
# Ohne Key läuft die Suche über den freien Exa-MCP-Endpoint: kostenlos,
# dafür wackliger. Mit Tavily-Key wird zuerst Tavily gefragt (zuverlässiger,
# liefert eine Zusammenfassung mit) und Exa ist nur noch der Fallback.
# Key: https://tavily.com
TAVILY_API_KEY=

# --- Notizen (optional) ---
# Absoluter Pfad zu einem Ordner mit Markdown-Dateien. Ein Obsidian-Vault ist
# genau das. Ohne Pfad laufen die Notiz-Tools gar nicht erst mit: der Agent
# recherchiert dann nur, statt vorher deine Vorgaben zu lesen.
# Beispiel: /Users/max/Documents/Notizen
NOTES_DIR=
# Unterordner, in dem gespeicherte Recherchen landen
NOTES_RESEARCH_FOLDER=Recherchen
# Notiz mit der Zielgruppe für die Lead-Recherche, Pfad relativ zu NOTES_DIR.
# Vorlage zum Kopieren: beispiele/Zielgruppe.example.md
LEADS_TARGET_NOTE=Zielgruppe.md

# --- Logging ---
LOG_LEVEL=INFO
