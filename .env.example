# ============================================================
# Nightcrawler configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env must NEVER be committed (it is in .gitignore).
# Only the first block is required. Everything else is optional:
# whatever stays empty is switched off, not broken.
# ============================================================

# --- LLM (required) ---
# Key: https://console.anthropic.com/settings/keys
# Alternatively leave empty and run `ant auth login` once; the SDK picks it up.
ANTHROPIC_API_KEY=

# Model for the agent. Research benefits from a strong model, because the
# cross-check and the filtering depend on it. claude-sonnet-5 is cheaper.
AGENT_MODEL=claude-opus-5-5
# Thinking depth: low / medium / high / xhigh / max. Set it explicitly:
# Opus 5.5 defaults to medium if omitted; research wants high.
EFFORT=high

# Mock mode: true = no real API calls, fake answers (free wiring test).
MOCK_LLM=false

# Maximum tool rounds per task. Research needs more than simple tasks:
# search fan, 6+ pages read, cross-check.
MAX_ROUNDS=25

# Evidence bar, checked in code before an answer is accepted.
MIN_PAGES=6
MIN_DOMAINS=4

# --- Persona (optional, prompt only) ---
OWNER_NAME=
AGENT_NAME=Nightcrawler
ANSWER_LANGUAGE=English
# concise / detailed / bullet points
ANSWER_STYLE=concise
TIMEZONE=Europe/Berlin

# --- User context (optional, strongly recommended) ---
# Your profile: home city, goals, budget, travel limit.
# Template: examples/profile.example.toml
PROFILE_PATH=profile.toml
# profile = location comes only from the profile (nothing leaves the machine
#           except the city name, sent to OpenStreetMap once for coordinates)
# ip      = approximate location from your public IP via ip-api.com (opt-in)
LOCATION_SOURCE=profile

# --- Web search (optional) ---
# Without a key, search runs over the free Exa MCP endpoint: free, but
# shakier. With a Tavily key, Tavily is asked first (more reliable, includes
# a summary) and Exa is only the fallback. Key: https://tavily.com
TAVILY_API_KEY=

# --- Notes (optional) ---
# Absolute path to a folder of Markdown files. An Obsidian vault is exactly
# that. Without a path the note tools are not offered at all.
# Example: /Users/alex/Documents/Notes
NOTES_DIR=
# Subfolder where saved research lands
NOTES_RESEARCH_FOLDER=Research
# Target-audience note for lead research, path relative to NOTES_DIR.
# Template: examples/target-audience.example.md
LEADS_TARGET_NOTE=target-audience.md

# --- Logging ---
LOG_LEVEL=INFO
