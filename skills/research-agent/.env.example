# Keys für den research-agent. ECHTE Werte gehören in eine .env (nicht committen)
# nie in dieses Skill oder in einen Report.
# Ohne Key fällt der jeweilige Kanal einfach auf den nächsten der Fetch-Leiter.

# Jina Reader/Search: hebt r.jina.ai von 20 auf 500 Anfragen/Minute. jina.ai
JINA_API_KEY=

# Key-Stapel (Free-Tiers, keine Karte nötig):
EXA_API_KEY=          # exa.ai (Startguthaben + monatliches Freikontingent)
SERPER_API_KEY=       # serper.dev (einmaliges Google-SERP-Kontingent)

# Tavily Search:
TAVILY_API_KEY=       # tavily.com (Free 1000 Credits/Monat)
